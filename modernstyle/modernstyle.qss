/*
 * ModernStyle style sheet. Every @name is replaced with the current theme's
 * colour (see themeColors() in modernstyle.cpp), so one sheet serves both the
 * light and the dark theme. @icons/<name>.png are images ModernStyle draws in
 * the theme's colours (check boxes, radio buttons, arrows; see writeImages()).
 * Edit freely: the sheet is loaded each time the theme changes.
 */

/* --- Buttons ------------------------------------------------------------- */

/* @buttonFill etc.: plain colours in the light theme, Slate's gradients in
   the dark theme (themeFills() in modernstyle.cpp) */
QPushButton {
    background: @buttonFill;
    color: @buttonText;
    border: 1px solid @buttonBorder;
    border-radius: 6px;
    padding: 5px 16px;
    min-height: 18px;
}
QPushButton:hover    { background: @buttonHoverFill; border-color: @buttonHoverBorder; }
QPushButton:pressed  { background: @buttonPressedFill; }
QPushButton:checked  { background-color: @accent; color: @accentText; border-color: @accent; }
QPushButton:disabled { color: @textDisabled; background-color: @window; border-color: @border; }
QPushButton:focus    { border-color: @accent; }

/* The default button (Enter) uses the accent colour */
QPushButton:default         { background-color: @accent; color: @accentText; border-color: @accent; }
QPushButton:default:hover   { background-color: @accentHover; border-color: @accentHover; }
QPushButton:default:pressed { background-color: @accentPressed; }
QPushButton:default:disabled,
QPushButton:checked:disabled { background-color: @border; color: @textDisabled; border-color: @border; }

QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px;
}
QToolButton:hover   { background-color: @controlHover; border-color: @border; }
QToolButton:pressed { background-color: @controlPressed; }
QToolButton:checked { background-color: @selection; border-color: @accent; }

/* --- Text fields, spin boxes, combo boxes ----------------------------------- */

QLineEdit, QTextEdit, QPlainTextEdit, QAbstractSpinBox, QComboBox {
    background-color: @surface;
    color: @text;
    border: 1px solid @border;
    border-radius: 6px;
    padding: 4px 6px;
    selection-background-color: @accent;
    selection-color: @accentText;
}
QLineEdit:hover, QTextEdit:hover, QPlainTextEdit:hover, QAbstractSpinBox:hover, QComboBox:hover {
    border-color: @borderStrong;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QAbstractSpinBox:focus, QComboBox:focus {
    border: 1px solid @accent;
}
QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled, QAbstractSpinBox:disabled,
QComboBox:disabled {
    color: @textDisabled;
    background-color: @window;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}
QComboBox::down-arrow          { image: url(@icons/chevron-down.png); width: 10px; height: 10px; }
QComboBox::down-arrow:disabled { image: url(@icons/chevron-down-disabled.png); }
QComboBox QAbstractItemView {
    background-color: @menu;
    border: 1px solid @border;
    border-radius: 6px;
    padding: 4px;
    outline: none;
    selection-background-color: @selection;
    selection-color: @text;
}

QAbstractSpinBox { padding-right: 20px; }
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button {
    subcontrol-origin: border;
    border: none;
    width: 18px;
    background: transparent;
}
QAbstractSpinBox::up-button   { subcontrol-position: top right; margin: 2px 2px 0 0; }
QAbstractSpinBox::down-button { subcontrol-position: bottom right; margin: 0 2px 2px 0; }
QAbstractSpinBox::up-arrow             { image: url(@icons/chevron-up.png); width: 10px; height: 10px; }
QAbstractSpinBox::down-arrow           { image: url(@icons/chevron-down.png); width: 10px; height: 10px; }
QAbstractSpinBox::up-arrow:disabled,
QAbstractSpinBox::up-arrow:off         { image: url(@icons/chevron-up-disabled.png); }
QAbstractSpinBox::down-arrow:disabled,
QAbstractSpinBox::down-arrow:off       { image: url(@icons/chevron-down-disabled.png); }
QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover {
    background-color: @controlHover;
    border-radius: 4px;
}

/* --- Check boxes and radio buttons ------------------------------------------------ */

QCheckBox, QRadioButton { spacing: 8px; }
QCheckBox::indicator, QGroupBox::indicator, QAbstractItemView::indicator,
QRadioButton::indicator { width: 16px; height: 16px; }

QCheckBox::indicator:unchecked, QGroupBox::indicator:unchecked, QAbstractItemView::indicator:unchecked
    { image: url(@icons/checkbox.png); }
QCheckBox::indicator:unchecked:hover, QGroupBox::indicator:unchecked:hover
    { image: url(@icons/checkbox-hover.png); }
QCheckBox::indicator:checked, QGroupBox::indicator:checked, QAbstractItemView::indicator:checked
    { image: url(@icons/checkbox-checked.png); }
QCheckBox::indicator:checked:hover, QGroupBox::indicator:checked:hover
    { image: url(@icons/checkbox-checked-hover.png); }
QCheckBox::indicator:indeterminate, QAbstractItemView::indicator:indeterminate
    { image: url(@icons/checkbox-indeterminate.png); }
QCheckBox::indicator:unchecked:disabled, QGroupBox::indicator:unchecked:disabled
    { image: url(@icons/checkbox-disabled.png); }
QCheckBox::indicator:checked:disabled, QGroupBox::indicator:checked:disabled
    { image: url(@icons/checkbox-checked-disabled.png); }
QCheckBox::indicator:indeterminate:disabled
    { image: url(@icons/checkbox-indeterminate-disabled.png); }

QRadioButton::indicator:unchecked          { image: url(@icons/radio.png); }
QRadioButton::indicator:unchecked:hover    { image: url(@icons/radio-hover.png); }
QRadioButton::indicator:checked            { image: url(@icons/radio-checked.png); }
QRadioButton::indicator:checked:hover      { image: url(@icons/radio-checked-hover.png); }
QRadioButton::indicator:unchecked:disabled { image: url(@icons/radio-disabled.png); }
QRadioButton::indicator:checked:disabled   { image: url(@icons/radio-checked-disabled.png); }

/* --- Lists, trees, tables ----------------------------------------------------- */

QAbstractItemView {
    background-color: @surface;
    alternate-background-color: @surfaceAlt;
    color: @text;
    border: 1px solid @border;
    border-radius: 6px;
    selection-background-color: @accent;
    selection-color: @accentText;
    gridline-color: @border;
}
QTableView QTableCornerButton::section {
    background-color: @surfaceAlt;
    border: none;
}
QHeaderView::section {
    background-color: @surfaceAlt;
    color: @textSecondary;
    border: none;
    border-right: 1px solid @border;
    border-bottom: 1px solid @border;
    padding: 4px 8px;
}

/* --- Tabs ----------------------------------------------------------------- */

QTabWidget::pane {
    border: 1px solid @border;
    border-radius: 10px;
    top: -1px;
    background-color: @window;
}
/* Start the tabs after the pane's rounded corner */
QTabWidget::tab-bar { left: 10px; }

/* Unselected tabs: their own fill, a gap between them, rounded tops */
QTabBar::tab {
    background: @tabFill;
    color: @textSecondary;
    border: 1px solid @border;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    padding: 6px 16px;
    margin-right: 4px;
    margin-top: 3px;              /* a little lower than the selected tab */
}
QTabBar::tab:hover:!selected { background: @tabHoverFill; color: @text; }

/* The selected tab: the pane's colour, joined to the pane, accent line on top */
QTabBar::tab:selected {
    background: @tabSelectedFill;
    color: @text;
    border-color: @border;
    border-top: 2px solid @accent;
    border-bottom-color: @window;
    margin-top: 0;
    padding-bottom: 7px;          /* covers the pane's top border */
}
QTabBar::tab:disabled { color: @textDisabled; }
QTabBar::tab:selected:disabled { border-top-color: @border; }

/* Tabs along the bottom, left or right of a QTabWidget: mirror the above */
QTabBar::tab:bottom {
    border-top-left-radius: 0; border-top-right-radius: 0;
    border-bottom-left-radius: 10px; border-bottom-right-radius: 10px;
    margin-top: 0; margin-bottom: 3px;
}
QTabBar::tab:bottom:selected {
    border-top: 1px solid @window; border-bottom: 2px solid @accent;
    margin-bottom: 0; padding-bottom: 6px; padding-top: 7px;
}

/* --- Group boxes ------------------------------------------------------------ */

QGroupBox {
    border: 1px solid @border;
    border-radius: 8px;
    margin-top: 14px;
    padding: 10px 8px 8px 8px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 4px;
    color: @textSecondary;
}

/* --- Scroll bars: slim and rounded, no arrow buttons ------------------------------- */

/* A scroll bar on its own shows its track... */
QScrollBar {
    background-color: @tab;
    border: 1px solid @border;
    border-radius: 6px;
}
QScrollBar:vertical   { width: 12px; }
QScrollBar:horizontal { height: 12px; }
/* ...inside lists, text areas and other scroll areas only the handle shows */
QAbstractScrollArea QScrollBar {
    background: transparent;
    border: none;
    margin: 2px;
}

QScrollBar::handle {
    background-color: @borderStrong;
    border-radius: 4px;
    min-width: 24px;
    min-height: 24px;
    margin: 1px;
}
QScrollBar::handle:hover   { background-color: @textSecondary; }
QScrollBar::handle:pressed { background-color: @accent; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; border: none; background: none; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }

/* --- Sliders and progress bars ---------------------------------------------------- */

QSlider::groove:horizontal { height: 4px; background-color: @borderStrong; border-radius: 2px; }
QSlider::groove:vertical   { width: 4px; background-color: @borderStrong; border-radius: 2px; }
QSlider::sub-page:horizontal { background-color: @accent; border-radius: 2px; }
QSlider::add-page:vertical   { background-color: @accent; border-radius: 2px; }
QSlider::handle {
    background-color: @accent;
    border: 3px solid @surface;
    width: 12px;
    height: 12px;
    border-radius: 9px;
}
QSlider::handle:horizontal { margin: -7px 0; }
QSlider::handle:vertical   { margin: 0 -7px; }
QSlider::handle:hover      { background-color: @accentHover; }
QSlider::sub-page:horizontal:disabled, QSlider::add-page:vertical:disabled,
QSlider::handle:disabled   { background-color: @textDisabled; }
QSlider::groove:disabled   { background-color: @border; }

QProgressBar {
    background-color: @surfaceAlt;
    border: 1px solid @border;
    border-radius: 6px;
    text-align: center;
    color: @text;
    min-height: 14px;
}
QProgressBar::chunk { background-color: @accent; border-radius: 5px; }
QProgressBar::chunk:disabled { background-color: @textDisabled; }

/* --- Menus, menu bar, tool bar, status bar ----------------------------------------- */

QMenuBar { background: transparent; color: @text; padding: 2px; }
QMenuBar::item { background: transparent; padding: 4px 10px; border-radius: 4px; }
QMenuBar::item:selected { background-color: @controlHover; }
QMenuBar::item:pressed  { background-color: @controlPressed; }

QMenu {
    background-color: @menu;
    color: @text;
    border: 1px solid @border;
    border-radius: 8px;
    padding: 4px;
}
QMenu::item { padding: 6px 28px 6px 24px; border-radius: 4px; }
QMenu::item:selected { background-color: @selection; }
QMenu::item:disabled { color: @textDisabled; }
QMenu::separator { height: 1px; background-color: @border; margin: 4px 8px; }

QToolBar { background: transparent; border: none; spacing: 4px; padding: 2px; }
QToolBar::separator { background-color: @border; width: 1px; margin: 4px 6px; }

QStatusBar { background: transparent; color: @textSecondary; }
QStatusBar::item { border: none; }

QToolTip {
    background-color: @tooltip;
    color: @text;
    border: 1px solid @border;
    padding: 4px 8px;
}

/* --- Qwt plots (https://qwt.sourceforge.io) ------------------------------------------
 * Only used when the application uses Qwt. qwtmodernstyle.h also styles what
 * a style sheet can't reach: curve colours, the grid and the axes.        */

QwtPlot { background: transparent; }
QwtPlotCanvas {
    background-color: @surface;
    border: 1px solid @border;
    border-radius: 10px;
}
QwtScaleWidget { color: @textSecondary; }       /* axis numbers, ticks and titles */
QwtLegend, QwtLegend QWidget { background: transparent; }
QwtLegendLabel { color: @text; }
QwtTextLabel { color: @text; }                  /* the plot's title and footer */

/* --- Frameless window (framelesswindow/): title bar text ------------------------------ */

TitleBar QLabel#titleText          { color: @text; }
TitleBar[active="false"] QLabel#titleText { color: @textSecondary; }
