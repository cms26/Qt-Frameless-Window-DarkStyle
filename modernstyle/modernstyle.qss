/*
 * ModernStyle style sheet. Every @name is replaced with the current theme's
 * colour (see themeColors() in modernstyle.cpp), so one sheet serves both the
 * light and the dark theme. @icons/<name>.png are images ModernStyle draws in
 * the theme's colours (check boxes, radio buttons, arrows; see writeImages()).
 * Edit freely: the sheet is loaded each time the theme changes.
 */

/* --- Buttons ------------------------------------------------------------- */

/* @buttonFill etc.: plain colours in the light theme, Slate's gradients in
   the dark theme (themeFills() in modernstyle.cpp) */
QPushButton {
    background: @buttonFill;
    color: @buttonText;
    border: 1px solid @buttonBorder;
    border-radius: 6px;
    padding: 5px 16px;
    min-height: 18px;
}
QPushButton:hover    { background: @buttonHoverFill; border-color: @buttonHoverBorder; }
QPushButton:pressed  { background: @buttonPressedFill; }
/* Checked (toggle) buttons: blue, darker when the mouse is over them */
QPushButton:checked         { background: @checkedFill; color: @checkedText; border-color: @checkedBorder; }
QPushButton:checked:hover   { background: @checkedHoverFill; }
QPushButton:checked:pressed { background: @checkedHoverFill; }
QPushButton:disabled { color: @textDisabled; background-color: @window; border-color: @border; }
QPushButton:focus    { border-color: @accent; }

/* The default button (Enter) uses the accent colour */
QPushButton:default         { background-color: @accent; color: @accentText; border-color: @accent; }
QPushButton:default:hover   { background-color: @accentHover; border-color: @accentHover; }
QPushButton:default:pressed { background-color: @accentPressed; }
QPushButton:default:disabled,
QPushButton:checked:disabled { background-color: @border; color: @textDisabled; border-color: @border; }

QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px;
}
/* Like buttons, tool buttons (toolbars) light up under the mouse. Checked
   ones are blue like checked buttons and turn darker under the mouse.
   :checked:hover comes after :checked, so it wins. */
QToolButton:hover           { background: @toolHoverFill; border-color: @buttonBorder; }
QToolButton:pressed         { background: @buttonPressedFill; border-color: @buttonBorder; }
QToolButton:checked         { background: @checkedFill; color: @checkedText; border-color: @checkedBorder; }
QToolButton:checked:hover   { background: @checkedHoverFill; border-color: @checkedBorder; }
QToolButton:checked:pressed { background: @checkedHoverFill; border-color: @checkedBorder; }

/* --- Text fields, spin boxes, combo boxes ----------------------------------- */

/* combobox-popup: 0 - a list below the combo box that shows at most
   maxVisibleItems() (Qt's default: 10) and then scrolls. Without it, a
   styled combo box opens a popup as tall as all its items (up to the whole
   screen). ModernStyle::setComboPopupMaxHeight() limits it in pixels too. */
QComboBox { combobox-popup: 0; }

QLineEdit, QTextEdit, QPlainTextEdit, QAbstractSpinBox, QComboBox {
    background-color: @surface;
    color: @text;
    border: 1px solid @border;
    border-radius: 6px;
    padding: 4px 6px;
    selection-background-color: @accent;
    selection-color: @accentText;
}
QLineEdit:hover, QTextEdit:hover, QPlainTextEdit:hover, QAbstractSpinBox:hover, QComboBox:hover {
    border-color: @borderStrong;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QAbstractSpinBox:focus, QComboBox:focus {
    border: 1px solid @accent;
}
QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled, QAbstractSpinBox:disabled,
QComboBox:disabled {
    color: @textDisabled;
    background-color: @window;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}
QComboBox::down-arrow          { image: url(@icons/chevron-down.png); width: 10px; height: 10px; }
QComboBox::down-arrow:disabled { image: url(@icons/chevron-down-disabled.png); }
QComboBox QAbstractItemView {
    background-color: @menu;
    border: 1px solid @border;
    border-radius: 6px;
    padding: 4px;
    outline: none;
    selection-background-color: @selection;
    selection-color: @text;
}

QAbstractSpinBox { padding-right: 20px; }
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button {
    subcontrol-origin: border;
    border: none;
    width: 18px;
    background: transparent;
}
QAbstractSpinBox::up-button   { subcontrol-position: top right; margin: 2px 2px 0 0; }
QAbstractSpinBox::down-button { subcontrol-position: bottom right; margin: 0 2px 2px 0; }
QAbstractSpinBox::up-arrow             { image: url(@icons/chevron-up.png); width: 10px; height: 10px; }
QAbstractSpinBox::down-arrow           { image: url(@icons/chevron-down.png); width: 10px; height: 10px; }
QAbstractSpinBox::up-arrow:disabled,
QAbstractSpinBox::up-arrow:off         { image: url(@icons/chevron-up-disabled.png); }
QAbstractSpinBox::down-arrow:disabled,
QAbstractSpinBox::down-arrow:off       { image: url(@icons/chevron-down-disabled.png); }
QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover {
    background-color: @controlHover;
    border-radius: 4px;
}

/* --- Check boxes and radio buttons ------------------------------------------------ */

QCheckBox, QRadioButton { spacing: 8px; }
QCheckBox::indicator, QGroupBox::indicator, QAbstractItemView::indicator,
QRadioButton::indicator { width: 16px; height: 16px; }

QCheckBox::indicator:unchecked, QGroupBox::indicator:unchecked, QAbstractItemView::indicator:unchecked
    { image: url(@icons/checkbox.png); }
QCheckBox::indicator:unchecked:hover, QGroupBox::indicator:unchecked:hover
    { image: url(@icons/checkbox-hover.png); }
QCheckBox::indicator:checked, QGroupBox::indicator:checked, QAbstractItemView::indicator:checked
    { image: url(@icons/checkbox-checked.png); }
QCheckBox::indicator:checked:hover, QGroupBox::indicator:checked:hover
    { image: url(@icons/checkbox-checked-hover.png); }
QCheckBox::indicator:indeterminate, QAbstractItemView::indicator:indeterminate
    { image: url(@icons/checkbox-indeterminate.png); }
QCheckBox::indicator:unchecked:disabled, QGroupBox::indicator:unchecked:disabled
    { image: url(@icons/checkbox-disabled.png); }
QCheckBox::indicator:checked:disabled, QGroupBox::indicator:checked:disabled
    { image: url(@icons/checkbox-checked-disabled.png); }
QCheckBox::indicator:indeterminate:disabled
    { image: url(@icons/checkbox-indeterminate-disabled.png); }
/* While the mouse button is held down on it */
QCheckBox::indicator:unchecked:pressed, QGroupBox::indicator:unchecked:pressed
    { image: url(@icons/checkbox-pressed.png); }
QCheckBox::indicator:checked:pressed, QGroupBox::indicator:checked:pressed
    { image: url(@icons/checkbox-checked-pressed.png); }
QCheckBox::indicator:indeterminate:pressed
    { image: url(@icons/checkbox-indeterminate-pressed.png); }

QRadioButton::indicator:unchecked          { image: url(@icons/radio.png); }
QRadioButton::indicator:unchecked:hover    { image: url(@icons/radio-hover.png); }
QRadioButton::indicator:checked            { image: url(@icons/radio-checked.png); }
QRadioButton::indicator:checked:hover      { image: url(@icons/radio-checked-hover.png); }
QRadioButton::indicator:unchecked:disabled { image: url(@icons/radio-disabled.png); }
QRadioButton::indicator:checked:disabled   { image: url(@icons/radio-checked-disabled.png); }
QRadioButton::indicator:unchecked:pressed  { image: url(@icons/radio-pressed.png); }
QRadioButton::indicator:checked:pressed    { image: url(@icons/radio-checked-pressed.png); }

/* --- Lists, trees, tables ----------------------------------------------------- */

QAbstractItemView {
    background-color: @surface;
    alternate-background-color: @surfaceAlt;
    color: @text;
    border: 1px solid @border;
    border-radius: 6px;
    selection-background-color: @accent;
    selection-color: @accentText;
    gridline-color: @border;
}
/* Selected rows of a disabled view: grey instead of the accent */
QAbstractItemView::item:selected:disabled { background-color: @border; color: @textDisabled; }

/* Headers: the same see-through band as toolbars, darker at the bottom */
QTableView QTableCornerButton::section {
    background: @toolbarBottomFill;
    border: none;
    border-bottom: 1px solid @border;
}
QHeaderView::section {
    background: @toolbarBottomFill;
    color: @textSecondary;
    border: none;
    border-right: 1px solid @border;
    border-bottom: 1px solid @border;
    padding: 4px 8px;
}

/* Tree views: lines from parent to child, arrows on items with children */
QTreeView::branch:has-siblings:!adjoins-item  { border-image: url(@icons/branch-line.png) 0; }
QTreeView::branch:has-siblings:adjoins-item   { border-image: url(@icons/branch-more.png) 0; }
QTreeView::branch:!has-children:!has-siblings:adjoins-item { border-image: url(@icons/branch-end.png) 0; }
QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    border-image: none;
    image: url(@icons/branch-closed.png);
}
QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
    border-image: none;
    image: url(@icons/branch-open.png);
}

/* --- Tabs ----------------------------------------------------------------- */

QTabBar { qproperty-drawBase: 0; }     /* no base line under tab bars on their own */

QTabWidget::pane {
    background: @boxFill;
    border: 1px solid @border;
    border-radius: 10px;
    top: -1px;
    background-color: @window;
}
/* Start the tabs after the pane's rounded corner */
QTabWidget::tab-bar { left: 10px; }

/* Unselected tabs: their own fill, a gap between them, rounded tops */
QTabBar::tab {
    background: @tabFill;
    color: @textSecondary;
    border: 1px solid @border;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    padding: 6px 16px;
    margin-right: 4px;
    margin-top: 3px;              /* a little lower than the selected tab */
}
QTabBar::tab:hover:!selected { background: @tabHoverFill; color: @text; }

/* The selected tab: the pane's colour, with a blue line under it */
QTabBar::tab:selected {
    background: @tabSelectedFill;
    color: @text;
    border-color: @border;
    border-bottom: 3px solid @accent;
    margin-top: 0;
    padding-bottom: 5px;          /* the same height as the others despite the line */
}
QTabBar::tab:disabled { color: @textDisabled; }
QTabBar::tab:selected:disabled { border-bottom-color: @border; }

/* Tabs along the bottom, left or right of a QTabWidget: mirror the above */
QTabBar::tab:bottom {
    border-top-left-radius: 0; border-top-right-radius: 0;
    border-bottom-left-radius: 10px; border-bottom-right-radius: 10px;
    margin-top: 0; margin-bottom: 3px;
}
QTabBar::tab:bottom:selected {
    border-top: 1px solid @border; border-bottom: 3px solid @accent;
    margin-bottom: 0; padding-bottom: 4px; padding-top: 6px;
}

/* --- Group boxes ------------------------------------------------------------ */

/* The title is a darker, rounded tab sitting on a thick grey line: the
   group box's top border */
QGroupBox {
    border: 1px solid @border;
    border-top: 3px solid @groupLine;
    border-radius: 8px;
    border-top-left-radius: 3px;  /* the line runs nearly square into the sides */
    border-top-right-radius: 3px;
    margin-top: 22px;             /* the title tab's height: it sits on the line */
    background: @boxFill;         /* a lighter, see-through area */
    padding: 10px 8px 8px 8px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 4px 12px;
    background-color: @groupTitle;
    color: @text;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}
QGroupBox::title:disabled { color: @textDisabled; }

/* --- Scroll bars: slim and rounded, no arrow buttons ------------------------------- */

/* A scroll bar on its own shows its track... */
QScrollBar {
    background-color: @tab;
    border: 1px solid @border;
    border-radius: 6px;
}
QScrollBar:vertical   { width: 12px; }
QScrollBar:horizontal { height: 12px; }
/* ...inside lists, text areas and other scroll areas only the handle shows */
QAbstractScrollArea QScrollBar {
    background: transparent;
    border: none;
    margin: 2px;
}

QScrollBar::handle {
    background-color: @groove;
    border-radius: 4px;
    min-width: 24px;
    min-height: 24px;
    margin: 1px;
}
QScrollBar::handle:hover   { background-color: @accent; }
QScrollBar::handle:pressed { background-color: @accent; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; border: none; background: none; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }

/* --- Sliders and progress bars ---------------------------------------------------- */

QSlider::groove:horizontal { height: 4px; background-color: @groove; border-radius: 2px; }
QSlider::groove:vertical   { width: 4px; background-color: @groove; border-radius: 2px; }
QSlider::sub-page:horizontal { background-color: @accent; border-radius: 2px; }
QSlider::add-page:vertical   { background-color: @accent; border-radius: 2px; }
QSlider::handle {
    background-color: @accent;
    border: 3px solid @surface;
    width: 12px;
    height: 12px;
    border-radius: 9px;
}
QSlider::handle:horizontal { margin: -7px 0; }
QSlider::handle:vertical   { margin: 0 -7px; }
QSlider::handle:hover      { background-color: @accentHover; }
QSlider::sub-page:horizontal:disabled, QSlider::add-page:vertical:disabled,
QSlider::handle:disabled   { background-color: @textDisabled; }
QSlider::groove:disabled   { background-color: @border; }

QProgressBar {
    background-color: @surfaceAlt;
    border: 1px solid @border;
    border-radius: 6px;
    text-align: center;
    color: @text;
    min-height: 14px;
}
QProgressBar::chunk { background-color: @accent; border-radius: 5px; }
QProgressBar::chunk:disabled { background-color: @textDisabled; }

/* --- Menus, menu bar, tool bar, status bar ----------------------------------------- */

/* Menu bar: the toolbar band, with a 2 px edge below */
QMenuBar {
    background: @toolbarTopFill;
    border-bottom: 2px solid @barEdge;
    color: @text;
    padding: 2px;
}
QMenuBar::item { background: transparent; padding: 4px 10px; border-radius: 4px; spacing: 2px; }
QMenuBar::item:selected {
    background: @menuBarItemHoverFill;
    border-left: 1px solid @menuBarItemEdge;
    border-right: 1px solid @menuBarItemEdge;
}
QMenuBar::item:pressed {
    background: @accent;
    color: @accentText;
    border-left: 1px solid @barEdge;
    border-right: 1px solid @barEdge;
}

QMenu {
    background-color: @menu;
    color: @text;
    border: 1px solid @border;
    border-radius: 8px;
    padding: 4px;
}
QMenu::item { padding: 6px 28px 6px 28px; border: 1px solid transparent; border-radius: 4px; }
QMenu::item:selected { background-color: @accent; color: @accentText; }
QMenu::item:disabled { color: @textDisabled; background: transparent; }

/* Checkable menu items: the same check boxes and radio buttons as elsewhere */
QMenu::indicator { width: 16px; height: 16px; left: 6px; }
QMenu::indicator:non-exclusive:unchecked { image: url(@icons/checkbox.png); }
QMenu::indicator:non-exclusive:checked   { image: url(@icons/checkbox-checked.png); }
QMenu::indicator:exclusive:unchecked     { image: url(@icons/radio.png); }
QMenu::indicator:exclusive:checked       { image: url(@icons/radio-checked.png); }
/* A checked item that has an icon: the icon gets a frame */
QMenu::icon:checked {
    background: @selection;
    border: 1px solid @accent;
    border-radius: 3px;
}
QMenu::separator { height: 1px; background-color: palette(alternate-base); margin: 4px 8px; }

/* Toolbars: a see-through band, darker towards the window's edge, with a
   3 px edge on the side facing the window's contents */
QToolBar { border: none; spacing: 4px; padding: 2px; }
QToolBar:top    { background: @toolbarTopFill;    border-bottom: 3px solid @toolbarTopFill; }
QToolBar:bottom { background: @toolbarBottomFill; border-top: 3px solid @toolbarBottomFill; }
QToolBar:left   { background: @toolbarLeftFill;   border-right: 3px solid @toolbarLeftFill; }
QToolBar:right  { background: @toolbarRightFill;  border-left: 3px solid @toolbarRightFill; }
QToolBar::separator { background-color: palette(alternate-base); width: 1px; margin: 4px 6px; }

/* --- Dock widgets: panels like Slate's cards ------------------------------------ */

/* Title bar: the card header ($card-cap-bg), rounded at the top */
QDockWidget {
    color: @textSecondary;
    titlebar-close-icon: url(@icons/dock-close.png);
    titlebar-normal-icon: url(@icons/dock-float.png);
}
QDockWidget::title {
    background-color: @panelHeader;
    border: 1px solid @border;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 5px 8px;
    text-align: left;
}
QDockWidget::close-button, QDockWidget::float-button {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 2px;
    icon-size: 12px;
}
QDockWidget::close-button:hover, QDockWidget::float-button:hover { background-color: @controlHover; }
QDockWidget::close-button:pressed, QDockWidget::float-button:pressed { background-color: @controlPressed; }

/* ModernStyle's own dock title bar (DockTitleBar): icon, title, buttons.
   The same card header look as above. */
QWidget#ModernDockTitle {
    background-color: @panelHeader;
    border: 1px solid @border;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}
QWidget#ModernDockTitle[floating="true"] {
    border-radius: 0;           /* a floating dock widget's window is square */
}
QLabel#ModernDockTitleText { color: @textSecondary; background: transparent; }
QLabel#ModernDockTitleIcon { background: transparent; }
QToolButton#ModernDockFloatButton, QToolButton#ModernDockCloseButton {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 2px;
}
QToolButton#ModernDockFloatButton:hover, QToolButton#ModernDockCloseButton:hover {
    background-color: @controlHover;
}
QToolButton#ModernDockFloatButton:pressed, QToolButton#ModernDockCloseButton:pressed {
    background-color: @controlPressed;
}
QToolButton#ModernDockFloatButton { qproperty-icon: url(@icons/dock-float.png); }
QToolButton#ModernDockCloseButton { qproperty-icon: url(@icons/dock-close.png); }

/* The contents: the card body ($card-bg), lighter than the window. Lists,
   text boxes etc. inside fill themselves with the same colour. */
QDockWidget > QWidget {
    background-color: @panel;
}

/* --- Splitters and the gaps between dock widgets ------------------------------ */

/* A strip in palette(alternate-base) with three grip dots in the middle,
   so it can be found; the accent colour while the mouse is over it. */
QSplitter::handle, QMainWindow::separator {
    background-color: palette(alternate-base);
}
QSplitter::handle:hover, QMainWindow::separator:hover,
QSplitter::handle:pressed, QMainWindow::separator:pressed {
    background-color: palette(highlight);
}
QSplitter::handle:horizontal { width: 10px; image: url(@icons/grip-vertical.png); }
QSplitter::handle:vertical   { height: 10px; image: url(@icons/grip-horizontal.png); }
QMainWindow::separator:vertical   { width: 6px; image: url(@icons/grip-vertical.png); }
QMainWindow::separator:horizontal { height: 6px; image: url(@icons/grip-horizontal.png); }

QStatusBar { background: @toolbarBottomFill; color: @textSecondary; }
QStatusBar::item { border: none; }

QToolTip {
    background-color: @tooltip;
    color: @text;
    border: 1px solid @accent;
    padding: 4px 8px;
}

/* --- Qwt plots (https://qwt.sourceforge.io) ------------------------------------------
 * Only used when the application uses Qwt. qwtmodernstyle.h also styles what
 * a style sheet can't reach: curve colours, the grid and the axes.        */

QwtPlot { background: transparent; }
QwtPlotCanvas {
    background-color: @surface;
    border: 1px solid @border;
    border-radius: 10px;
}
QwtScaleWidget { color: @textSecondary; }       /* axis numbers, ticks and titles */
QwtLegend, QwtLegend QWidget { background: transparent; }
QwtLegendLabel { color: @text; }
QwtTextLabel { color: @text; }                  /* the plot's title and footer */

/* --- Frameless window (framelesswindow/): title bar text ------------------------------ */

TitleBar QLabel#titleText          { color: @text; }
TitleBar[active="false"] QLabel#titleText { color: @textSecondary; }
