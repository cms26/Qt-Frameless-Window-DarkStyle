/*
 * ModernStyle style sheet. Every @name is replaced with the current theme's
 * colour (see themeColors() in modernstyle.cpp), so one sheet serves both the
 * light and the dark theme. @icons/<name>.png are images ModernStyle draws in
 * the theme's colours (check boxes, radio buttons, arrows; see writeImages()).
 * Edit freely: the sheet is loaded each time the theme changes.
 */

/* --- Buttons ------------------------------------------------------------- */

/* @buttonFill etc.: grey gradients in both themes (themeFills() in
   modernstyle.cpp) */
QPushButton {
    background: @buttonFill;
    color: @buttonText;
    border: 1px solid @buttonBorder;
    border-radius: 6px;
    padding: 5px 20px;
    min-height: 18px;
}
QPushButton:hover    { background: @buttonHoverFill; border-color: @buttonHoverBorder; }
QPushButton:pressed  { background: @buttonPressedFill; }
/* Checked (toggle) buttons: blue, darker when the mouse is over them */
QPushButton:checked         { background: @checkedFill; color: @checkedText; border-color: @checkedBorder; }
QPushButton:checked:hover   { background: @checkedHoverFill; }
QPushButton:checked:pressed { background: @checkedHoverFill; }
QPushButton:disabled { color: @textDisabled; background-color: @buttonDisabledFill; border-color: @border; }

/* The default button (Enter) uses the accent colour */
QPushButton:default         { background-color: @accent; color: @accentText; border-color: @accent; }
QPushButton:default:hover   { background-color: @accentHover; border-color: @accentHover; }
QPushButton:default:pressed { background-color: @accentPressed; }
QPushButton:default:disabled,
QPushButton:checked:disabled { background-color: @buttonDisabledFill; color: @textDisabled; border-color: @border; }

QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px;
}
/* Like buttons, tool buttons (toolbars) light up under the mouse. Checked
   ones are blue like checked buttons and turn darker under the mouse.
   :checked:hover comes after :checked, so it wins. */
QToolButton:hover           { background: @toolHoverFill; border-color: @buttonBorder; }
QToolButton:pressed         { background: @buttonPressedFill; border-color: @buttonBorder; }
QToolButton:checked         { background: @checkedFill; color: @checkedText; border-color: @checkedBorder; }
QToolButton:checked:hover   { background: @checkedHoverFill; border-color: @checkedBorder; }
QToolButton:checked:pressed { background: @checkedHoverFill; border-color: @checkedBorder; }

/* --- Text fields, spin boxes, combo boxes ----------------------------------- */

/* combobox-popup: 0 - a list below the combo box that shows at most
   maxVisibleItems() (Qt's default: 10) and then scrolls. Without it, a
   styled combo box opens a popup as tall as all its items (up to the whole
   screen). ModernStyle::setComboPopupMaxHeight() limits it in pixels too. */
QComboBox { combobox-popup: 0; }

QLineEdit, QTextEdit, QPlainTextEdit, QAbstractSpinBox, QComboBox {
    background-color: @surface;
    color: @text;
    border: 1px solid @border;
    border-radius: 6px;
    padding: 4px 6px;
    selection-background-color: @accent;
    selection-color: @accentText;
}
QLineEdit:hover, QTextEdit:hover, QPlainTextEdit:hover, QAbstractSpinBox:hover, QComboBox:hover {
    border-color: @borderStrong;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QAbstractSpinBox:focus, QComboBox:focus {
    border: 1px solid @accent;
}
/* Read-only text (QTextBrowser, read-only line and text edits): no blue
   focus border, as they aren't typed into; the stronger border under the mouse */
QLineEdit[readOnly="true"]:focus, QTextEdit[readOnly="true"]:focus, QPlainTextEdit[readOnly="true"]:focus {
    border-color: @border;
}
QLineEdit[readOnly="true"]:focus:hover, QTextEdit[readOnly="true"]:focus:hover,
QPlainTextEdit[readOnly="true"]:focus:hover {
    border-color: @borderStrong;
}
QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled, QAbstractSpinBox:disabled,
QComboBox:disabled {
    color: @textDisabled;
    background-color: @window;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}
QComboBox::down-arrow          { image: url(@icons/chevron-down.png); width: 10px; height: 10px; }
QComboBox::down-arrow:disabled { image: url(@icons/chevron-down-disabled.png); }
QComboBox QAbstractItemView {
    background-color: @menu;
    border: 1px solid @border;
    border-radius: 6px;
    padding: 4px;
    outline: none;
    selection-background-color: @selection;
    selection-color: @text;
}

/* Room for the buttons on the right; a little room on the left, also when
   the spin box has no frame (an editor in a table or tree cell) */
QAbstractSpinBox { padding-left: 8px; padding-right: 20px; }
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button {
    subcontrol-origin: border;
    border: none;
    width: 18px;
    background: transparent;
}
QAbstractSpinBox::up-button   { subcontrol-position: top right; margin: 2px 2px 0 0; }
QAbstractSpinBox::down-button { subcontrol-position: bottom right; margin: 0 2px 2px 0; }
QAbstractSpinBox::up-arrow             { image: url(@icons/chevron-up.png); width: 10px; height: 10px; }
QAbstractSpinBox::down-arrow           { image: url(@icons/chevron-down.png); width: 10px; height: 10px; }
QAbstractSpinBox::up-arrow:disabled,
QAbstractSpinBox::up-arrow:off         { image: url(@icons/chevron-up-disabled.png); }
QAbstractSpinBox::down-arrow:disabled,
QAbstractSpinBox::down-arrow:off       { image: url(@icons/chevron-down-disabled.png); }
QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover {
    background-color: @controlHover;
    border-radius: 4px;
}

/* --- Check boxes and radio buttons ------------------------------------------------ */

QCheckBox, QRadioButton { spacing: 8px; }
QCheckBox::indicator, QGroupBox::indicator, QAbstractItemView::indicator,
QRadioButton::indicator { width: 18px; height: 18px; }

QCheckBox::indicator:unchecked, QGroupBox::indicator:unchecked, QAbstractItemView::indicator:unchecked
    { image: url(@icons/checkbox.png); }
QCheckBox::indicator:unchecked:hover, QGroupBox::indicator:unchecked:hover
    { image: url(@icons/checkbox-hover.png); }
QCheckBox::indicator:checked, QGroupBox::indicator:checked, QAbstractItemView::indicator:checked
    { image: url(@icons/checkbox-checked.png); }
QCheckBox::indicator:checked:hover, QGroupBox::indicator:checked:hover
    { image: url(@icons/checkbox-checked-hover.png); }
QCheckBox::indicator:indeterminate, QAbstractItemView::indicator:indeterminate
    { image: url(@icons/checkbox-indeterminate.png); }
QCheckBox::indicator:unchecked:disabled, QGroupBox::indicator:unchecked:disabled
    { image: url(@icons/checkbox-disabled.png); }
QCheckBox::indicator:checked:disabled, QGroupBox::indicator:checked:disabled
    { image: url(@icons/checkbox-checked-disabled.png); }
QCheckBox::indicator:indeterminate:disabled
    { image: url(@icons/checkbox-indeterminate-disabled.png); }
/* While the mouse button is held down on it */
QCheckBox::indicator:unchecked:pressed, QGroupBox::indicator:unchecked:pressed
    { image: url(@icons/checkbox-pressed.png); }
QCheckBox::indicator:checked:pressed, QGroupBox::indicator:checked:pressed
    { image: url(@icons/checkbox-checked-pressed.png); }
QCheckBox::indicator:indeterminate:pressed
    { image: url(@icons/checkbox-indeterminate-pressed.png); }

QRadioButton::indicator:unchecked          { image: url(@icons/radio.png); }
QRadioButton::indicator:unchecked:hover    { image: url(@icons/radio-hover.png); }
QRadioButton::indicator:checked            { image: url(@icons/radio-checked.png); }
QRadioButton::indicator:checked:hover      { image: url(@icons/radio-checked-hover.png); }
QRadioButton::indicator:unchecked:disabled { image: url(@icons/radio-disabled.png); }
QRadioButton::indicator:checked:disabled   { image: url(@icons/radio-checked-disabled.png); }
QRadioButton::indicator:unchecked:pressed  { image: url(@icons/radio-pressed.png); }
QRadioButton::indicator:checked:pressed    { image: url(@icons/radio-checked-pressed.png); }

/* --- Lists, trees, tables ----------------------------------------------------- */

QAbstractItemView {
    background-color: @surface;
    alternate-background-color: @surfaceAlt;
    color: @text;
    border: 1px solid @border;
    border-radius: 6px;
    selection-background-color: @accent;
    selection-color: @accentText;
    gridline-color: @border;
}
/* Trees and tables: every other row in the window colour */
QTreeView, QTableView { alternate-background-color: @window; background: @surface; }
QTreeView::branch { background-color: @surface; }
/* Selected rows of a disabled view: grey instead of the accent */
QAbstractItemView::item:selected:disabled { background: @disabledSelection; color: @textDisabled; }

/* Headers: the same see-through band as toolbars, darker at the bottom */
/* Headers are item views too: not the field look above, but palette(button)
   under the band, as Qt draws them by default */
QHeaderView { background-color: palette(button); border: none; border-radius: 0; }
QTableView QTableCornerButton::section {
    background: @toolbarBottomFill;
    border: none;
    border-bottom: 1px solid palette(dark);
}
QHeaderView::section {
    background: @toolbarBottomFill;
    color: @textSecondary;
    border-style: none;
    border-bottom: 1px solid palette(dark);
    padding-left: 5px;
    padding-right: 5px;
}

/* Lists: a little space between items; the check box's pressed look */
QListWidget::item { margin-top: 3px; }
QListView::indicator:pressed { image: url(@icons/checkbox-checked-pressed.png); }

/* The colour dialog: wide enough spin boxes and a bigger colour field */
QColorDialog QSpinBox { min-width: 3.5em; }
QColorDialog QColorPicker { min-width: 20em; min-height: 20em; }

/* Tree views: lines from parent to child, arrows on items with children */
QTreeView::branch:has-siblings:!adjoins-item  { border-image: url(@icons/branch-line.png) 0; }
QTreeView::branch:has-siblings:adjoins-item   { border-image: url(@icons/branch-more.png) 0; }
QTreeView::branch:!has-children:!has-siblings:adjoins-item { border-image: url(@icons/branch-end.png) 0; }
QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    border-image: none;
    image: url(@icons/branch-closed.png);
}
QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
    border-image: none;
    image: url(@icons/branch-open.png);
}

/* --- Tabs ----------------------------------------------------------------- */

QTabBar { qproperty-drawBase: 0; }     /* no base line under tab bars on their own */

QTabWidget::pane {
    background: @boxFill;
    border: none;
    border-top: 1px solid @softLine;
}
QTabWidget::tab-bar { left: 3px; top: 1px; }

QTabBar {
    background: transparent;
    border-bottom: 1px solid @softLine;
}
QTabBar::tab {
    background: @tabFill;
    color: @textSecondary;
    border: 1px solid @barEdge;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    padding: 4px 6px;
    margin-right: 2px;
}
QTabBar::tab:!selected { margin-top: 2px; }    /* a little lower than the selected tab */
QTabBar::tab:selected, QTabBar::tab:hover {
    background: @tabHoverFill;
    color: @text;
    border-bottom-color: @tabSelectedEdge;
}
/* The selected tab: a blue line under it (grey when disabled) */
QTabBar::tab:selected { border-bottom: 2px solid palette(highlight); }
QTabBar::tab:selected:disabled { border-bottom: 2px solid rgb(127, 127, 127); }
QTabBar::tab:disabled { color: @textDisabled; }

/* Tabs along the bottom (e.g. tabbed dock widgets): mirrored */
QTabBar::tab:bottom {
    border-top-left-radius: 0; border-top-right-radius: 0;
    border-bottom-left-radius: 4px; border-bottom-right-radius: 4px;
}
QTabBar::tab:bottom:!selected { margin-top: 0; margin-bottom: 2px; }
QTabBar::tab:bottom:selected { border-top: 1px solid @barEdge; border-bottom: 2px solid palette(highlight); }

/* --- Group boxes ------------------------------------------------------------ */

/* A lighter, see-through box; the title is a small tab on top of it with
   a grey line under it (the application's own group box style) */
QGroupBox {
    background: @boxFill;
    margin-top: 27px;
    border: 1px solid @groupBorder;
    border-radius: 4px;
    padding: 10px 8px 8px 8px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: left top;
    padding: 4px 6px;
    margin-left: 3px;
    background: @toolbarBottomFill;
    color: @text;
    border: 1px solid @barEdge;
    border-bottom: 2px solid @groupTitleLine;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}
QGroupBox::title:disabled { color: @textDisabled; }

/* --- Scroll bars: the base colour as track, no arrow buttons -------------------------- */

QScrollBar { background: @surface; border: none; margin: 0; }
QScrollBar:vertical {
    width: 16px;
    border-top-right-radius: 2px;
    border-bottom-right-radius: 2px;
}
QScrollBar:horizontal { height: 16px; }
/* The handle: @groove, a lighter grey than palette(alternate-base), so it
   stands out on the track */
QScrollBar::handle { background-color: @groove; border-radius: 2px; }
QScrollBar::handle:vertical   { min-height: 20px; margin: 2px 4px 2px 4px; }
QScrollBar::handle:horizontal { min-width: 20px;  margin: 4px 2px 4px 2px; }
QScrollBar::handle:hover, QScrollBar::handle:pressed { background-color: palette(highlight); }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; border: none; background: none; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }

/* --- Sliders and progress bars ---------------------------------------------------- */

/* Horizontal sliders: a rounded grey handle; the track filled with the
   highlight colour left of it, the base colour right of it */
QSlider::groove:horizontal { height: 8px; border-radius: 4px; background: @surface; }
QSlider::sub-page:horizontal { background: palette(highlight); border-radius: 4px; }
QSlider::add-page:horizontal { background: @surface; border-radius: 4px; }
QSlider::handle:horizontal {
    border-radius: 4px;
    border: 1px solid @sliderHandleBorder;
    background-color: @surfaceAlt;
    width: 12px;
    min-height: 18px;
    margin: -5px -4px;
}
QSlider::handle:horizontal:hover { background: palette(highlight); }
QSlider::sub-page:horizontal:disabled { background: @disabledSelection; }

/* Vertical sliders: the same, turned */
QSlider::groove:vertical { width: 8px; border-radius: 4px; background: @surface; }
QSlider::add-page:vertical { background: palette(highlight); border-radius: 4px; }
QSlider::sub-page:vertical { background: @surface; border-radius: 4px; }
QSlider::handle:vertical {
    border-radius: 4px;
    border: 1px solid @sliderHandleBorder;
    background-color: @surfaceAlt;
    height: 12px;
    min-width: 18px;
    margin: -4px -5px;
}
QSlider::handle:vertical:hover { background: palette(highlight); }
QSlider::add-page:vertical:disabled { background: @disabledSelection; }

QProgressBar {
    background-color: @surfaceAlt;
    border: 1px solid @border;
    border-radius: 6px;
    text-align: center;
    color: @text;
    min-height: 14px;
}
QProgressBar::chunk { background-color: @accent; border-radius: 5px; }
QProgressBar::chunk:disabled { background-color: @textDisabled; }

/* --- Menus, menu bar, tool bar, status bar ----------------------------------------- */

/* Menu bar: the toolbar band, with a 2 px edge below */
QMenuBar {
    background: @toolbarTopFill;
    border-bottom: 2px solid @barEdge;
    color: @text;
    padding: 2px;
}
QMenuBar::item { background: transparent; padding: 3px 4px; spacing: 2px; }
QMenuBar::item:selected {
    background: @menuBarItemHoverFill;
    border-left: 1px solid @menuBarItemEdge;
    border-right: 1px solid @menuBarItemEdge;
    color: palette(highlighted-text);
}
QMenuBar::item:pressed {
    background: palette(highlight);
    color: palette(highlighted-text);
    border-left: 1px solid @pressedEdge;
    border-right: 1px solid @pressedEdge;
}

QMenu {
    background-color: palette(window);
    color: @text;
    border: 1px solid @menuBorder;
}
QMenu::item { padding: 3px 25px 3px 25px; border: 1px solid transparent; }
QMenu::item:disabled { background-color: @menuDisabledFill; color: @textDisabled; }
QMenu::item:selected {
    border-color: @menuSelectedEdge;
    background: palette(highlight);
    color: palette(highlighted-text);
}
/* A checked item that has an icon: the icon gets a frame */
QMenu::icon:checked {
    background: @toolbarBottomFill;
    border: 1px solid palette(highlight);
    border-radius: 2px;
}
QMenu::separator { height: 1px; background: palette(alternate-base); margin-left: 5px; margin-right: 5px; }

/* Checkable menu items: the same check boxes and radio buttons as elsewhere */
QMenu::indicator { width: 18px; height: 18px; }
QMenu::indicator:non-exclusive:unchecked { image: url(@icons/checkbox.png); padding-left: 2px; }
QMenu::indicator:non-exclusive:checked   { image: url(@icons/checkbox-checked.png); padding-left: 2px; }
QMenu::indicator:exclusive:unchecked     { image: url(@icons/radio.png); padding-left: 2px; }
QMenu::indicator:exclusive:checked       { image: url(@icons/radio-checked.png); padding-left: 2px; }

/* Toolbars: a see-through band, darker towards the window's edge, with a
   3 px edge on the side facing the window's contents */
QToolBar { border: none; spacing: 4px; padding: 2px; }

/* Buttons in toolbars: raised grey buttons with a groove edge; under the
   mouse the darker toolbar band; checked blue, darker under the mouse.
   (These win over the QToolButton rules above.) */
QToolBar QToolButton {
    spacing: 2px;
    padding: 5px 7px;
    background: @barButtonFill;
    border: 2px groove @barButtonBorder;
    border-radius: 4px;
}
QToolBar QToolButton:hover         { background: @barButtonHoverFill; }
QToolBar QToolButton:pressed       { background: @buttonPressedFill; }
QToolBar QToolButton:checked       { background: @checkedFill; color: @checkedText; }
QToolBar QToolButton:checked:hover { background: @checkedHoverFill; }
QToolBar:top    { background: @toolbarTopFill;    border-bottom: 3px solid @toolbarTopFill; }
QToolBar:bottom { background: @toolbarBottomFill; border-top: 3px solid @toolbarBottomFill; }
QToolBar:left   { background: @toolbarLeftFill;   border-right: 3px solid @toolbarLeftFill; }
QToolBar:right  { background: @toolbarRightFill;  border-left: 3px solid @toolbarRightFill; }
QToolBar::separator { background-color: palette(alternate-base); width: 1px; margin: 4px 6px; }

/* --- Dock widgets: panels, lighter than the window ------------------------------ */

/* Title bar: the toolbar band, with a darker 2 px edge below */
QDockWidget {
    color: @textSecondary;
    titlebar-close-icon: url(@icons/dock-close.png);
    titlebar-normal-icon: url(@icons/dock-float.png);
}
QDockWidget::title {
    background: @toolbarBottomFill;
    border: 1px solid @barEdge;
    border-bottom: 2px solid @barEdge;
    padding: 4px;
    text-align: left;
}
QDockWidget::close-button, QDockWidget::float-button {
    subcontrol-position: top right;
    subcontrol-origin: margin;
    position: absolute;
    top: 3px;
    bottom: 0px;
    width: 20px;
    height: 20px;
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 2px;
    icon-size: 12px;
}
QDockWidget::close-button { right: 3px; }
QDockWidget::float-button { right: 25px; }
QDockWidget::close-button:hover, QDockWidget::float-button:hover { background-color: @controlHover; }
QDockWidget::close-button:pressed, QDockWidget::float-button:pressed { background-color: @controlPressed; }

/* ModernStyle's own dock title bar (DockTitleBar): icon, title, buttons.
   The same look as above. */
QWidget#ModernDockTitle {
    background: @toolbarBottomFill;
    border: 1px solid @barEdge;
    border-bottom: 2px solid @barEdge;
}
QWidget#ModernDockTitle[floating="true"] {
    border-radius: 0;           /* a floating dock widget's window is square */
}
QLabel#ModernDockTitleText { color: @textSecondary; background: transparent; }
QLabel#ModernDockTitleIcon { background: transparent; }
QToolButton#ModernDockFloatButton, QToolButton#ModernDockCloseButton {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 2px;
}
QToolButton#ModernDockFloatButton:hover, QToolButton#ModernDockCloseButton:hover {
    background-color: @controlHover;
}
QToolButton#ModernDockFloatButton:pressed, QToolButton#ModernDockCloseButton:pressed {
    background-color: @controlPressed;
}
QToolButton#ModernDockFloatButton { qproperty-icon: url(@icons/dock-float.png); }
QToolButton#ModernDockCloseButton { qproperty-icon: url(@icons/dock-close.png); }

/* The contents: lighter than the window. Lists,
   text boxes etc. inside fill themselves with the same colour. */
QDockWidget > QWidget {
    background-color: @panel;
}

/* --- Splitters and the gaps between dock widgets ------------------------------ */

/* A strip in palette(alternate-base) with three grip dots in the middle,
   so it can be found; the accent colour while the mouse is over it. */
QSplitter::handle, QMainWindow::separator {
    background-color: palette(alternate-base);
}
QSplitter::handle:hover, QMainWindow::separator:hover,
QSplitter::handle:pressed, QMainWindow::separator:pressed {
    background-color: palette(highlight);
}
QSplitter::handle:horizontal { width: 10px; image: url(@icons/grip-vertical.png); }
QSplitter::handle:vertical   { height: 10px; image: url(@icons/grip-horizontal.png); }
QMainWindow::separator:vertical   { width: 6px; image: url(@icons/grip-vertical.png); }
QMainWindow::separator:horizontal { height: 5px; image: url(@icons/grip-horizontal.png); }

QStatusBar { background: @toolbarTopFill; color: @textSecondary; }
QStatusBar::item { border: none; }
QStatusBar QWidget { padding: 3px; }

QToolTip {
    background-color: @tooltip;
    color: @text;
    border: 1px solid @accent;
    padding: 1px 2px;   /* Qt adds the border and padding again as the label's margin */
}

/* --- Qwt plots (https://qwt.sourceforge.io) ------------------------------------------
 * Only used when the application uses Qwt. qwtmodernstyle.h also styles what
 * a style sheet can't reach: curve colours, the grid and the axes.        */

QwtPlot { background: transparent; }
QwtPlotCanvas {
    background-color: @surface;
    border: 1px solid @border;
    border-radius: 10px;
}
QwtScaleWidget { color: @textSecondary; }       /* axis numbers, ticks and titles */
QwtLegend, QwtLegend QWidget { background: transparent; }
QwtLegendLabel { color: @text; }
/* Legend entries are buttons: raised grey, the toolbar band under the mouse;
   with a checkable legend (QwtLegendData::Checkable) hidden curves are
   italic and thin, shown ones bold and blue. "QwtLegend QwtLegendLabel" so
   these win over the transparent "QwtLegend QWidget" above. */
QwtLegend QwtLegendLabel {
    padding: 1px;
    background: @barButtonFill;
    border: 2px groove @barButtonBorder;
    border-radius: 4px;
}
QwtLegend QwtLegendLabel:hover { background: @barButtonHoverFill; }
QwtLegend QwtLegendLabel[checked="false"] {
    font-style: italic;
    font-weight: 200;
    border: 3px groove @barButtonBorder;
}
QwtLegend QwtLegendLabel[checked="true"] {
    font-weight: 800;
    background: @checkedFill;
    color: @checkedText;
}
QwtLegend QwtLegendLabel[checked="true"]:hover { background: @checkedHoverFill; }
QwtTextLabel { color: @text; }                  /* the plot's title and footer */

/* --- Frameless window (framelesswindow/): title bar text ------------------------------ */

TitleBar QLabel#titleText          { color: @text; }
TitleBar[active="false"] QLabel#titleText { color: @textSecondary; }

/* --- Frame settings from Qt Designer / code ------------------------------------------
 * The rules above give text boxes, lists, tables and trees ModernStyle's own
 * border, which would otherwise override their frameShape / frameShadow. These
 * follow those settings instead (and come last, so they also win on hover and
 * focus). Plain QFrame widgets ("Frame" in Designer) aren't styled above, so
 * their shape and shadow are drawn as usual. A value changed with
 * setFrameShape() / setFrameShadow() after the widget is shown takes effect
 * after style()->unpolish(w); style()->polish(w);
 */

/* frameShape NoFrame: no border at all */
QFrame[frameShape="NoFrame"] {
    border: none;
}

/* frameShadow Plain: a plain line in the stronger border colour, square corners */
QAbstractItemView[frameShadow="Plain"], QTextEdit[frameShadow="Plain"],
QPlainTextEdit[frameShadow="Plain"] {
    border: 1px solid @borderStrong;
    border-radius: 0;
}

/* frameShadow Raised: a raised 3D edge */
QAbstractItemView[frameShadow="Raised"], QTextEdit[frameShadow="Raised"],
QPlainTextEdit[frameShadow="Raised"] {
    border: 2px outset @borderStrong;
    border-radius: 0;
}

/* frameShadow Sunken is the default for these widgets: ModernStyle's own
   rounded border, as above. NoFrame wins over any shadow. */
QAbstractItemView[frameShape="NoFrame"], QTextEdit[frameShape="NoFrame"],
QPlainTextEdit[frameShape="NoFrame"] {
    border: none;
}

/* frame off on line edits, combo boxes and spin boxes: no border */
QLineEdit[frame="false"], QComboBox[frame="false"], QAbstractSpinBox[frame="false"] {
    border: none;
}
